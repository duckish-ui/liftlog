generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  unit         String     @default("lb")
  createdAt    DateTime   @default(now())
  workouts     Workout[]
  exercises    Exercise[]
}

model Exercise {
  id          String   @id @default(cuid())
  wgerId      Int?     @unique
  name        String
  category    String
  muscles     String[]
  equipment   String[]
  description String   @default("")
  // null = shared library exercise (imported from wger); set = a user's custom exercise
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets        WorkoutSet[]
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([userId])
}

model Workout {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String       @default("")
  date        DateTime     @default(now())
  durationMin Int          @default(0)
  sets        WorkoutSet[]
  createdAt   DateTime     @default(now())

  @@index([userId, date])
}

model WorkoutSet {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order      Int
  setNumber  Int
  reps       Int
  weight     Float

  @@index([workoutId])
  @@index([exerciseId])
}
